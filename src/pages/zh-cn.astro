---
import { BookOpen, ChevronRight, Mail, MapPin } from 'lucide-astro';
import PublicationList from '../components/PublicationList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { awards, experience, news, site, type PublicationCategory } from '../data/site';

const zhResearchAreas = ['数据挖掘', '大语言模型', '具身智能', '计算机视觉', '体育人工智能', '多模态', '可解释性AI', '可视分析'];
const zhPublicationLabels = {
  llm: '大语言模型',
  'visual-analytics': '可视分析',
  'explainable-ai': '可解释性AI',
  visualization: '可视化',
} satisfies Record<PublicationCategory, string>;

const description = '马骥的中文个人主页。浙江大学计算机科学与技术博士生，研究体育人工智能。';
const zhNews = [
  '论文 T3Set 被 ACM KDD 2025 录用。',
  '论文 TacPrint 被 IEEE PacificVis 2024 TVCG journal track 录用。',
];
const zhExperience = [
  { title: '计算机科学与技术  博士生', affiliation: '浙江大学', location: '中国杭州', description: '研究方向为数据挖掘与以人为中心的人工智能，师从巫英才教授。' },
  { title: '计算机科学与技术  本科生', affiliation: '浙江大学', location: '中国杭州', description: '2020 年起在巫英才教授指导下开展体育人工智能相关研究；竺可桢学院混合班。' },
];
const zhServices = [
{ year: '2022起', title: '架构师', detail: '服务某乒乓球女队，担任大数据平台首席架构师，助力备战重大国际赛事。' },
  { year: '2026', title: '会议审稿人', detail: 'KDD 2026' },
  { year: '2025', title: '课程助教', detail: '浙江大学《计算机科学与技术思想史》' },
  { year: '2022起', title: '服务器运维', detail: '运维超300万算力集群' },
    { year: '2023起', title: 'Mentor', detail: '累计指导10名本科生（科研项目）和4名硕士生（工程项目）。' },

];
const runningServiceItems = [
  { year: '2022.8-2026.5', title: '领队组组长', detail: '主持负责夸父长跑联盟例跑事务。辐射浙大师生逾1600名，社团活动年参与人次超5000。' },
  { year: '2024.4-2025.5', title: '夸父长跑联盟社团申请负责人', detail: '牵头申请成立浙江大学学生夸父长跑联盟社团，填补浙江大学长期没有学生长跑社团的空白。' },
  { year: '2025.6-2026.6', title: '夸父长跑联盟社团负责人', detail: '第一任社团负责人兼办公室部长，领队组组长。夸父长跑联盟训练队曾获2025年高校百英里总决赛第6名, 高校百英里上海站冠军。' },
  { year: '2024.10-2026.5', title: '助理教练', detail: '浙江大学教职工跑协学生助理教练' },
];
const researchEngineeringServiceItems = [zhServices[0], zhServices[3], zhServices[4], zhServices[2], zhServices[1]];
const zhAwards = [
  '浙江大学优秀研究生干部', '浙江大学优秀研究生', '浙江大学五好研究生',
  '浙江大学研究生朋辈心理辅导员', '浙江大学优秀本科毕业生', '竺可桢学院荣誉证书',
  '国家级大学生创新创业训练计划（国创）', '浙江大学一等奖学金',
  '全国中学生数学奥林匹克竞赛（省级）二等奖', '全国中学生物理奥林匹克竞赛（省级）二等奖',
  '全国中学生化学奥林匹克竞赛（省级）三等奖', '全国中学生生物学奥林匹克竞赛（省级）二等奖',
];
---

<BaseLayout title="马骥 | 浙江大学计算机科学博士生" description={description} lang="zh-CN" canonicalUrl="https://csjima.site/zh-cn/">
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="#top" aria-label="返回页首"><span>{site.name}</span><span class="brand-zh">马骥</span></a>
      <nav aria-label="主导航">
        <a href="https://csjima.site/">English</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section id="top" class="hero page-shell" aria-labelledby="page-title">
      <div class="portrait-wrap"><img class="portrait" src="/imgs/mj/maji.jpg" alt="马骥的照片" /></div>
      <div class="hero-copy">
        <p class="eyebrow">CS PHD</p>
        <h1 id="page-title">马骥 <span>Ji Ma</span></h1>
        <div id="about" class="about-copy">
          <p>马骥，浙江大学 CAD&amp;CG 国家重点实验室计算机科学与技术博士生，师从巫英才教授。</p>
          <p>研究领域为体育人工智能和数据挖掘，关注如何将领域专家知识融入数据驱动的AI模型。目前的工作聚焦于利用多模态感知、具身智能和大模型，探索乒乓球智能教练与自动技战术分析。</p>


        </div>
        <div class="contact-links">
          <a href={site.email}><Mail size={17} aria-hidden="true" /><span>{site.emailLabel}</span></a>
        </div>
        <ul class="research-pills" aria-label="研究兴趣">
          {zhResearchAreas.map((area) => <li>{area}</li>)}
        </ul>
      </div>
    </section>

    <div class="page-shell content-grid">
      <div class="primary-column">


        <section id="publications" class="content-section publications-section" aria-labelledby="publications-title">
          <div class="section-heading"><h2 id="publications-title">论文与项目</h2></div>
          <PublicationList labels={zhPublicationLabels} allLabel="全部" filterAriaLabel="按研究方向筛选论文" emptyMessage="该分类暂无论文。" />



        </section>

        <section id="experience" class="content-section" aria-labelledby="experience-title">
          <div class="section-heading"><h2 id="experience-title">教育背景</h2></div>
          <div class="timeline">
            {experience.map((item, index) => { const text = zhExperience[index]; return <article class="timeline-item"><div class="timeline-logo"><img src={item.image} alt="浙江大学校徽" loading="lazy" /></div><div><time>{item.duration}</time><h3>{text.title}</h3><p class="timeline-affiliation">{text.affiliation} · {text.location}</p><p>{text.description}</p></div></article>; })}
          </div>
        </section>
        <section id="service" class="content-section" aria-labelledby="service-title">
          <div class="section-heading"><h2 id="service-title">服务经历</h2></div>
          <div class="service-list service-list--plain">
            {runningServiceItems.map((item) => <article class="service-item"><time>{item.year}</time><div><h4>{item.title}</h4><p>{item.detail}</p></div></article>)}
          </div>
        </section>
      </div>

      <aside class="secondary-column" aria-label="其他信息">
        <section class="side-section"><h2>科研与工程</h2><ul class="compact-list">{researchEngineeringServiceItems.map((item) => <li><time>{item.year}</time><div><strong>{item.title}</strong><span>{item.detail}</span></div></li>)}</ul></section>
        <section class="side-section"><h2>获奖与荣誉</h2><ul class="compact-list awards-list">{awards.map((item, index) => <li><time>{item.year}</time><span>{zhAwards[index]}</span></li>)}</ul></section>
      </aside>
    </div>
  </main>

  <footer><div class="page-shell footer-inner"><p>© {new Date().getFullYear()} 马骥</p></div></footer>
</BaseLayout>
