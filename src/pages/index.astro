---
import { BookOpen, ChevronRight, Mail, MapPin } from 'lucide-astro';
import About from '../content/about.mdx';
import PublicationList from '../components/PublicationList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { awards, experience, news, services, site } from '../data/site';

const description = 'Academic homepage of Ji Ma, a Computer Science Ph.D. candidate at Zhejiang University working on large language models, embodied intelligence, sports simulation, and table tennis AI.';
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ji Ma',
  alternateName: '马骥',
  url: 'https://jima-cs.github.io/',
  image: 'https://jima-cs.github.io/imgs/mj/maji.jpg',
  jobTitle: site.role,
  affiliation: { '@type': 'CollegeOrUniversity', name: site.affiliation },
  sameAs: [site.scholar],
  knowsAbout: site.researchAreas,
};
---

<BaseLayout title="Ji Ma | Computer Science Ph.D. Candidate" description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="#top" aria-label="Ji Ma — back to top">
        <span>{site.name}</span><span class="brand-zh">{site.nameZh}</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#news">News</a>
        <a href="#publications">Publications</a>
        <a href="#experience">Experience</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section id="top" class="hero page-shell" aria-labelledby="page-title">
      <div class="portrait-wrap">
        <img class="portrait" src="/imgs/mj/maji.jpg" alt="Portrait of Ji Ma" />
      </div>
      <div class="hero-copy">
        <p class="eyebrow">{site.role}</p>
        <h1 id="page-title">{site.name} <span>{site.nameZh}</span></h1>
        <p class="affiliation"><MapPin size={16} aria-hidden="true" /> {site.affiliation} · Hangzhou, China</p>
        <div id="about" class="about-copy"><About /></div>
        <div class="contact-links">
          <a href={site.email}><Mail size={17} aria-hidden="true" /><span>{site.emailLabel}</span></a>
          <a href={site.scholar} target="_blank" rel="noopener noreferrer"><BookOpen size={17} aria-hidden="true" /><span>Google Scholar</span></a>
        </div>
        <ul class="research-pills" aria-label="Research interests">
          {site.researchAreas.map((area) => <li>{area}</li>)}
        </ul>
      </div>
    </section>

    <div class="page-shell content-grid">
      <div class="primary-column">
        <section id="news" class="content-section" aria-labelledby="news-title">
          <div class="section-heading">
            <p>Updates</p>
            <h2 id="news-title">News</h2>
          </div>
          <ol class="news-list">
            {news.map((item) => (
              <li>
                <time>{item.date}</time>
                <p>{item.text}</p>
                <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`Read more: ${item.text}`}>
                  <ChevronRight size={18} aria-hidden="true" />
                </a>
              </li>
            ))}
          </ol>
        </section>

        <section id="publications" class="content-section publications-section" aria-labelledby="publications-title">
          <div class="section-heading">
            <p>Research</p>
            <h2 id="publications-title">Publications</h2>
          </div>
          <PublicationList />
        </section>

        <section id="experience" class="content-section" aria-labelledby="experience-title">
          <div class="section-heading">
            <p>Background</p>
            <h2 id="experience-title">Education & Experience</h2>
          </div>
          <div class="timeline">
            {experience.map((item) => (
              <article class="timeline-item">
                <div class="timeline-logo"><img src={item.image} alt="Zhejiang University logo" loading="lazy" /></div>
                <div>
                  <time>{item.duration}</time>
                  <h3>{item.title}</h3>
                  <p class="timeline-affiliation">{item.affiliation} · {item.location}</p>
                  <p>{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      </div>

      <aside class="secondary-column" aria-label="Additional information">
        <section class="side-section">
          <h2>Service</h2>
          <ul class="compact-list">
            {services.map((item) => (
              <li><time>{item.year}</time><div><strong>{item.title}</strong><span>{item.detail}</span></div></li>
            ))}
          </ul>
        </section>
        <section class="side-section">
          <h2>Selected Awards</h2>
          <ul class="compact-list awards-list">
            {awards.map((item) => <li><time>{item.year}</time><span>{item.title}</span></li>)}
          </ul>
        </section>
      </aside>
    </div>
  </main>

  <footer>
    <div class="page-shell footer-inner">
      <p>© {new Date().getFullYear()} Ji Ma</p>
      <div class="registration-links">
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="nofollow noopener noreferrer">浙ICP备2024062276号-1</a>
        <a href="http://www.beian.gov.cn/portal/registerSystemInfo?recordcode=33010602013435" target="_blank" rel="nofollow noopener noreferrer">浙公网安备33010602013435号</a>
      </div>
    </div>
  </footer>
</BaseLayout>
